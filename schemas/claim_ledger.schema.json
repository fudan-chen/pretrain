{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fudan-chen.github.io/pretrain/schemas/claim_ledger.schema.json",
  "title": "Marin tracker claim ledger",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_from_data_as_of",
    "run_id",
    "claims"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "generated_from_data_as_of": {"type": "string", "format": "date-time"},
    "run_id": {"type": "string", "minLength": 1},
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "claim.schema.json"}
    }
  }
}
