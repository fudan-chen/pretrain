{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fudan-chen.github.io/pretrain/schemas/claim.schema.json",
  "title": "Marin tracker claim",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "support",
    "statement",
    "as_of",
    "evidence",
    "caveats"
  ],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "kind": {"enum": ["OBSERVED", "DERIVED", "INFERRED"]},
    "support": {
      "enum": ["supported", "contradicted", "insufficient_evidence", "conflicted"]
    },
    "statement": {"type": "string", "minLength": 1},
    "as_of": {"type": "string", "format": "date-time"},
    "value": {"type": ["number", "string", "boolean", "null"]},
    "unit": {"type": "string", "minLength": 1},
    "facts": {"type": "object"},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/evidenceRef"}
    },
    "derivation": {
      "type": "object",
      "required": ["method_id"],
      "properties": {
        "method_id": {"type": "string", "minLength": 1},
        "equation": {"type": "string", "minLength": 1},
        "parameters": {"type": "object"},
        "method": {"type": "string", "minLength": 1},
        "inputs": {"type": "object"},
        "recipe_regime_id": {"type": ["string", "null"], "minLength": 1},
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/applicabilityCheck"}
        }
      },
      "additionalProperties": false
    },
    "uncertainty": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "prediction_sensitivity_range",
        "residual_sensitivity_range",
        "significance"
      ],
      "properties": {
        "kind": {"const": "sensitivity_only"},
        "prediction_sensitivity_range": {"$ref": "#/$defs/numericRange"},
        "residual_sensitivity_range": {"$ref": "#/$defs/numericRange"},
        "significance": {"const": "not_assessed"}
      }
    },
    "confidence": {"enum": ["high", "medium", "low", "unassessed"]},
    "alternative_explanations": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "falsifiers": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "caveats": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "numericRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["low", "high"],
      "properties": {
        "low": {"type": "number"},
        "high": {"type": "number"}
      }
    },
    "applicabilityCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "selector", "operator", "expected", "observed", "result"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "selector": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "operator": {"enum": ["equals", "contains"]},
        "expected": true,
        "observed": true,
        "result": {"enum": ["match", "mismatch", "unverified"]}
      }
    },
    "evidenceRef": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["artifact", "sha256"],
          "properties": {
            "artifact": {"type": "string", "minLength": 1},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "metric_key": {"type": "string", "minLength": 1},
            "step": {"type": "integer", "minimum": 0},
            "record_selector": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "type": ["string", "number", "boolean", "null"]
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256", "provider"],
          "properties": {
            "path": {"type": "string", "minLength": 1},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "provider": {"type": "string", "minLength": 1},
            "sampling": {"type": ["string", "null"]}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["claim_id"],
          "properties": {
            "claim_id": {"type": "string", "minLength": 1}
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["kind"],
        "properties": {"kind": {"const": "DERIVED"}}
      },
      "then": {"required": ["derivation"]}
    },
    {
      "if": {
        "required": ["kind"],
        "properties": {"kind": {"const": "INFERRED"}}
      },
      "then": {
        "required": [
          "confidence",
          "alternative_explanations",
          "falsifiers",
          "caveats"
        ]
      }
    }
  ]
}
